# Let Keycloak supply its own CSP/frame headers for login and OIDC iframe endpoints.
map $uri $nixu_csp {
  default "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'";
  ~^/auth/ "";
}
map $uri $nixu_frame { default DENY; ~^/auth/ ""; }
limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;
server {
  listen 443 ssl;
  server_name {{ nixu_domain }};
  ssl_certificate /etc/letsencrypt/live/{{ nixu_domain }}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{ nixu_domain }}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  server_tokens off;
  client_max_body_size 11m;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options $nixu_frame always;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header Content-Security-Policy $nixu_csp always;
  root /usr/share/nginx/html;
  resolver 127.0.0.11 valid=10s ipv6=off;
  location /api/ {
    limit_req zone=api burst=60 nodelay;
    set $backend http://api:8080;
    proxy_pass $backend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 60s;
  }
  location = /health { set $backend http://api:8080/actuator/health; proxy_pass $backend; }
  location /auth/admin/ {
{% for cidr in nixu_admin_cidrs %}
    allow {{ cidr }};
{% endfor %}
    deny all;
    set $auth http://keycloak:8080;
    proxy_pass $auth;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
  }
  location ~ ^/auth/realms/[^/]+/(login-actions|protocol/openid-connect/token) {
    limit_req zone=login burst=15 nodelay;
    set $auth http://keycloak:8080;
    proxy_pass $auth;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
  }
  location /auth/ {
    set $auth http://keycloak:8080;
    proxy_pass $auth;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
  }
  location = /config.js { add_header Cache-Control "no-store"; }
  location / { try_files $uri $uri/ /index.html; }
}
